package com.mypoo2.ejercicio_17;


public class calculos {
    static final float PI = 3.1416f;

    // Método estático para el área
    public static float calcularArea(float radio) {
        return PI * radio * radio;
    }

    // Método estático para la longitud
    public static float calcularLongitud(float radio) {
        return 2 * PI * radio;
    }
    }
